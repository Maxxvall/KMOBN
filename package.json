{
  "name": "karkas-master",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite --mode electron\" \"tsc -p tsconfig.electron.json --watch\" \"sleep 3 && electron .\"",
    "start": "vite --host",
    "build": "vite build",
    "build:electron": "vite build --mode electron && tsc -p tsconfig.electron.json && electron-builder",
    "build:web": "vite build --mode production",
    "build:electron:win": "vite build --mode electron && tsc -p tsconfig.electron.json && electron-builder --win",
    "preview": "vite preview",
    "dist": "electron-builder --win --publish never",
    "lint": "eslint \"App.tsx\" \"index.tsx\" \"constants.ts\" \"types.ts\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"services/**/*.ts\" \"vite.config.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.28.0",
    "electron-store": "^10.0.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lodash.debounce": "^4.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-focus-lock": "^2.13.7",
    "react-loading-skeleton": "^3.5.0",
    "react-window": "^2.2.3",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.karkas-master.desktop",
    "productName": "Каркас Мастер",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
