{
  "name": "karkas-master",
  "private": true,
  "version": "1.7.7",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite --mode electron\" \"tsc -p tsconfig.electron.json --watch\" \"sleep 3 && electron .\"",
    "start": "vite --host",
    "build": "vite build --configLoader runner",
    "build:electron": "vite build --mode electron --configLoader runner && tsc -p tsconfig.electron.json && electron-builder",
    "build:electron:e2e": "vite build --mode electron-e2e --configLoader runner && tsc -p tsconfig.electron.json",
    "build:web": "vite build --mode production --configLoader runner",
    "build:electron:win": "vite build --mode electron --configLoader runner && tsc -p tsconfig.electron.json && electron-builder --win",
    "preview": "vite preview",
    "dist": "electron-builder --win --publish never",
    "lint": "eslint \"App.tsx\" \"index.tsx\" \"types.ts\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"services/**/*.ts\" \"vite.config.ts\"",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:e2e:electron": "npm run build:electron:e2e && playwright test --config=playwright.electron.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "docx": "9.7.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lodash.debounce": "^4.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-focus-lock": "^2.13.7",
    "react-loading-skeleton": "^3.5.0",
    "react-window": "^2.2.3",
    "recharts": "^2.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.4",
    "electron": "^43.1.0",
    "electron-builder": "26.15.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "flatted": "3.4.2",
    "js-yaml": "5.2.1",
    "lodash": "4.18.1",
    "ws": "8.21.0"
  },
  "build": {
    "appId": "com.karkas-master.desktop",
    "productName": "Каркас Мастер",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Setup.${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Maxxvall",
      "repo": "KMOBN"
    },
    "protocols": {
      "name": "Karkas Master",
      "schemes": [
        "karkasmaster"
      ]
    }
  }
}
